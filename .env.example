# Copy to .env and fill in. NEVER commit .env.

# --- LLM providers (OpenAI-compatible endpoints) ---
# Primary generation model (complex tasks)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Fallback / judge model (use a DIFFERENT vendor than the primary to avoid same-source bias in evals)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Optional local tier: llama-server serving a local GGUF (data never leaves the machine)
# Start:  llama-server.exe -m "D:\AI\models\llm\YOUR-MODEL.gguf" --port 8100 --jinja
LLAMA_SERVER_URL=http://localhost:8100/v1
LLAMA_SERVER_MODEL=qwen2.5-7b-local

# --- Data ---
KAGGLE_USERNAME=
KAGGLE_KEY=
