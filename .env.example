# Copy to .env and fill in. NEVER commit .env.

# --- LLM providers (OpenAI-compatible endpoints) ---
# Primary generation model (complex tasks)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Fallback / judge model (use a DIFFERENT vendor than the primary to avoid same-source bias in evals)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Optional local tier via Ollama (pluggable; CPU-only machines can leave empty)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# --- Data ---
KAGGLE_USERNAME=
KAGGLE_KEY=
